<svg width="200" height="200" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <style>
      @keyframes rotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      .telegram-spinner {
        animation: rotate 2s linear infinite;
        transform-origin: 100px 100px;
      }
    </style>
  </defs>
  
  <!-- Background -->
  <rect width="200" height="200" fill="#0088cc"/>
  
  <!-- Telegram loading spinner -->
  <g class="telegram-spinner">
    <!-- Outer circle outline -->
    <circle cx="100" cy="100" r="80" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="8"/>
    
    <!-- Rotating progress arc -->
    <circle cx="100" cy="100" r="80" fill="none" stroke="white" stroke-width="8" 
            stroke-dasharray="125.6 502.4" stroke-linecap="round"
            style="filter: drop-shadow(0 0 4px rgba(255,255,255,0.5))"/>
  </g>
  
  <!-- Optional: Telegram logo in center -->
  <text x="100" y="110" font-size="40" fill="white" text-anchor="middle" font-weight="bold">✈</text>
</svg>